<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/maven-v4_0_0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>org.openmrs.module</groupId>
    <artifactId>rwandapharmacymanagement</artifactId>
    <version>1.0.7-SNAPSHOT</version>
    <packaging>pom</packaging>

    <name>Rwanda Pharmacy Management Module</name>
    <description>OpenMRS 2.x pharmacy management module for Rwanda health facilities</description>

    <modules>
        <module>api</module>
        <module>omod</module>
    </modules>

    <properties>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <openMRSVersion>2.6.15</openMRSVersion>
        <appframeworkVersion>2.18.0</appframeworkVersion>
        <appuiVersion>1.18.0</appuiVersion>
        <coreappsVersion>3.0.0</coreappsVersion>
        <emrapiVersion>2.4.0</emrapiVersion>
        <legacyuiVersion>1.23.0</legacyuiVersion>
        <uicommonsVersion>2.26.0</uicommonsVersion>
        <uiframeworkVersion>4.0.0</uiframeworkVersion>
        <uilibraryVersion>2.0.7</uilibraryVersion>
        <webservicesRestVersion>2.50.0</webservicesRestVersion>
        <htmlformentryVersion>7.3.0-SNAPSHOT</htmlformentryVersion>
        <mavenOpenmrsPluginVersion>1.0.1</mavenOpenmrsPluginVersion>

        <MODULE_ID>${project.parent.artifactId}</MODULE_ID>
        <MODULE_NAME>Rwanda Pharmacy Management</MODULE_NAME>
        <MODULE_VERSION>${project.parent.version}</MODULE_VERSION>
        <MODULE_PACKAGE>${project.parent.groupId}.${project.parent.artifactId}</MODULE_PACKAGE>
        <omodHbmConfig>
            AdjustmentReason.hbm.xml
            ClinicalSafetyRule.hbm.xml
            DeliveryReceipt.hbm.xml
            DeliveryReceiptLine.hbm.xml
            DepartmentBulkRequest.hbm.xml
            DepartmentBulkRequestLine.hbm.xml
            DepartmentStockIssue.hbm.xml
            DepartmentStockReturn.hbm.xml
            DepartmentStockReturnLine.hbm.xml
            DispenseRecord.hbm.xml
            DispenseRecordLine.hbm.xml
            IntegrationLog.hbm.xml
            InterPharmacyTransfer.hbm.xml
            InterPharmacyTransferLine.hbm.xml
            InventoryBalance.hbm.xml
            Item.hbm.xml
            ItemCategory.hbm.xml
            PatientDispensingRequest.hbm.xml
            PatientDispensingRequestLine.hbm.xml
            PharmacyLocation.hbm.xml
            PurchaseOrder.hbm.xml
            PurchaseOrderItem.hbm.xml
            ProductMasterItem.hbm.xml
            StockAdjustment.hbm.xml
            StockAdjustmentLine.hbm.xml
            StockTransaction.hbm.xml
            Supplier.hbm.xml
            SupplierOrder.hbm.xml
            SupplierOrderLine.hbm.xml
            SupplierPrice.hbm.xml
            SupplierProductMapping.hbm.xml
            SupplierSetting.hbm.xml
            InterPharmacyTransferLineBatch.hbm.xml
        </omodHbmConfig>
    </properties>

    <dependencies>
        <dependency>
            <groupId>org.openmrs.test</groupId>
            <artifactId>openmrs-test</artifactId>
            <version>${openMRSVersion}</version>
            <type>pom</type>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.openmrs.api</groupId>
            <artifactId>openmrs-api</artifactId>
            <version>${openMRSVersion}</version>
            <scope>provided</scope>
        </dependency>
        <dependency>
            <groupId>org.openmrs.api</groupId>
            <artifactId>openmrs-api</artifactId>
            <version>${openMRSVersion}</version>
            <classifier>tests</classifier>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.openmrs.module</groupId>
            <artifactId>appframework-api</artifactId>
            <version>${appframeworkVersion}</version>
            <scope>provided</scope>
        </dependency>
        <dependency>
            <groupId>org.openmrs.module</groupId>
            <artifactId>emrapi-api</artifactId>
            <version>${emrapiVersion}</version>
            <scope>provided</scope>
        </dependency>
    </dependencies>

</project>
