<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE hibernate-mapping PUBLIC
 "-//Hibernate/Hibernate Mapping DTD 3.0//EN"
 "http://hibernate.sourceforge.net/hibernate-mapping-3.0.dtd">
<hibernate-mapping package="org.openmrs.module.rwandapharmacymanagement.model">
    <class name="IntegrationLog" table="rpm_integration_log">
        <id name="integrationLogId" type="int" column="integration_log_id" unsaved-value="0">
            <generator class="native"/>
        </id>
        <property name="integrationType" column="integration_type">
            <type name="org.hibernate.type.EnumType">
                <param name="enumClass">org.openmrs.module.rwandapharmacymanagement.model.enums.IntegrationType</param>
                <param name="useNamed">true</param>
            </type>
        </property>
        <property name="status" column="status">
            <type name="org.hibernate.type.EnumType">
                <param name="enumClass">org.openmrs.module.rwandapharmacymanagement.model.enums.IntegrationStatus</param>
                <param name="useNamed">true</param>
            </type>
        </property>
        <property name="endpoint" column="endpoint" type="string"/>
        <property name="requestPayload" column="request_payload" type="text" length="16777215"/>
        <property name="responsePayload" column="response_payload" type="text" length="16777215"/>
        <property name="summary" column="summary" type="string"/>
        <property name="durationMs" column="duration_ms" type="long"/>
        <property name="retryCount" column="retry_count" type="integer"/>
        <property name="lastAttemptDate" column="last_attempt_date"/>
        <property name="referenceId" column="reference_id" type="integer"/>
        <many-to-one name="creator" class="org.openmrs.User" column="creator"/>
        <property name="dateCreated" column="date_created"/>
        <property name="voided" column="voided" type="boolean"/>
        <many-to-one name="voidedBy" class="org.openmrs.User" column="voided_by"/>
        <property name="dateVoided" column="date_voided"/>
        <property name="voidReason" column="void_reason" type="string"/>
    </class>
</hibernate-mapping>
