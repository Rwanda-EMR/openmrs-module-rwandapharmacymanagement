<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE hibernate-mapping PUBLIC
 "-//Hibernate/Hibernate Mapping DTD 3.0//EN"
 "http://hibernate.sourceforge.net/hibernate-mapping-3.0.dtd">
<hibernate-mapping package="org.openmrs.module.rwandapharmacymanagement.model">
    <class name="DispenseRecordLine" table="rpm_dispense_record_line">
        <id name="dispenseRecordLineId" type="int" column="dispense_record_line_id" unsaved-value="0">
            <generator class="native"/>
        </id>
        <many-to-one name="dispenseRecord" class="org.openmrs.module.rwandapharmacymanagement.model.DispenseRecord" column="dispense_record_id"/>
        <many-to-one name="item" class="org.openmrs.module.rwandapharmacymanagement.model.Item" column="item_id"/>
        <property name="batchNumber" column="batch_number" type="string"/>
        <property name="expiryDate" column="expiry_date"/>
        <property name="quantityDispensed" column="quantity_dispensed" type="big_decimal"/>
        <property name="costPrice" column="cost_price" type="big_decimal"/>
        <property name="sellingPrice" column="selling_price" type="big_decimal"/>
        <property name="lineTotal" column="line_total" type="big_decimal"/>
        <many-to-one name="creator" class="org.openmrs.User" column="creator"/>
        <property name="dateCreated" column="date_created"/>
        <property name="voided" column="voided" type="boolean"/>
        <many-to-one name="voidedBy" class="org.openmrs.User" column="voided_by"/>
        <property name="dateVoided" column="date_voided"/>
        <property name="voidReason" column="void_reason" type="string"/>
    </class>
</hibernate-mapping>
