<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE hibernate-mapping PUBLIC
 "-//Hibernate/Hibernate Mapping DTD 3.0//EN"
 "http://hibernate.sourceforge.net/hibernate-mapping-3.0.dtd">
<hibernate-mapping package="org.openmrs.module.rwandapharmacymanagement.model">
    <class name="InterPharmacyTransfer" table="rpm_inter_pharmacy_transfer">
        <id name="interPharmacyTransferId" type="int" column="inter_pharmacy_transfer_id" unsaved-value="0">
            <generator class="native"/>
        </id>
        <many-to-one name="sourcePharmacyLocation" class="org.openmrs.module.rwandapharmacymanagement.model.PharmacyLocation" column="source_pharmacy_location_id"/>
        <many-to-one name="destinationPharmacyLocation" class="org.openmrs.module.rwandapharmacymanagement.model.PharmacyLocation" column="destination_pharmacy_location_id"/>
        <property name="reason" column="reason" type="string"/>
        <property name="transferStatus" column="transfer_status" type="string"/>
        <many-to-one name="approvedBy" class="org.openmrs.User" column="approved_by"/>
        <property name="approvedDate" column="approved_date"/>
        <many-to-one name="rejectedBy" class="org.openmrs.User" column="rejected_by"/>
        <property name="rejectedDate" column="rejected_date"/>
        <property name="rejectionReason" column="rejection_reason" type="string"/>
        <many-to-one name="servedBy" class="org.openmrs.User" column="served_by"/>
        <property name="servedDate" column="served_date"/>
        <bag name="lines" cascade="all-delete-orphan" inverse="true" lazy="false">
            <key column="inter_pharmacy_transfer_id"/>
            <one-to-many class="org.openmrs.module.rwandapharmacymanagement.model.InterPharmacyTransferLine"/>
        </bag>
        <many-to-one name="creator" class="org.openmrs.User" column="creator"/>
        <property name="dateCreated" column="date_created"/>
        <property name="voided" column="voided" type="boolean"/>
        <many-to-one name="voidedBy" class="org.openmrs.User" column="voided_by"/>
        <property name="dateVoided" column="date_voided"/>
        <property name="voidReason" column="void_reason" type="string"/>
    </class>
</hibernate-mapping>
