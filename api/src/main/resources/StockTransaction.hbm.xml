<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE hibernate-mapping PUBLIC
 "-//Hibernate/Hibernate Mapping DTD 3.0//EN"
 "http://hibernate.sourceforge.net/hibernate-mapping-3.0.dtd">
<hibernate-mapping package="org.openmrs.module.rwandapharmacymanagement.model">
    <class name="StockTransaction" table="rpm_stock_transaction">
        <id name="stockTransactionId" type="int" column="stock_transaction_id" unsaved-value="0">
            <generator class="native"/>
        </id>
        <many-to-one name="item" class="org.openmrs.module.rwandapharmacymanagement.model.Item" column="item_id"/>
        <many-to-one name="pharmacyLocation" class="org.openmrs.module.rwandapharmacymanagement.model.PharmacyLocation" column="pharmacy_location_id"/>
        <property name="transactionType" column="transaction_type">
            <type name="org.hibernate.type.EnumType">
                <param name="enumClass">org.openmrs.module.rwandapharmacymanagement.model.enums.StockTransactionType</param>
                <param name="useNamed">true</param>
            </type>
        </property>
        <property name="batchNumber" column="batch_number" type="string"/>
        <property name="expiryDate" column="expiry_date"/>
        <property name="quantity" column="quantity" type="big_decimal"/>
        <property name="unitPrice" column="unit_price" type="big_decimal"/>
        <property name="totalAmount" column="total_amount" type="big_decimal"/>
        <property name="referenceNumber" column="reference_number" type="string"/>
        <property name="remarks" column="remarks" type="string"/>
        <many-to-one name="performedBy" class="org.openmrs.User" column="performed_by"/>
        <many-to-one name="creator" class="org.openmrs.User" column="creator"/>
        <property name="dateCreated" column="date_created"/>
        <property name="voided" column="voided" type="boolean"/>
        <many-to-one name="voidedBy" class="org.openmrs.User" column="voided_by"/>
        <property name="dateVoided" column="date_voided"/>
        <property name="voidReason" column="void_reason" type="string"/>
    </class>
</hibernate-mapping>
