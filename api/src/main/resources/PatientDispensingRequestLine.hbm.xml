<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE hibernate-mapping PUBLIC
 "-//Hibernate/Hibernate Mapping DTD 3.0//EN"
 "http://hibernate.sourceforge.net/hibernate-mapping-3.0.dtd">
<hibernate-mapping package="org.openmrs.module.rwandapharmacymanagement.model">
    <class name="PatientDispensingRequestLine" table="rpm_patient_dispensing_request_line">
        <id name="patientDispensingRequestLineId" type="int" column="patient_dispensing_request_line_id" unsaved-value="0">
            <generator class="native"/>
        </id>
        <many-to-one name="patientDispensingRequest" class="org.openmrs.module.rwandapharmacymanagement.model.PatientDispensingRequest" column="patient_dispensing_request_id"/>
        <many-to-one name="order" class="org.openmrs.DrugOrder" column="order_id"/>
        <many-to-one name="item" class="org.openmrs.module.rwandapharmacymanagement.model.Item" column="item_id"/>
        <property name="requestedQuantity" column="requested_quantity" type="big_decimal"/>
        <property name="unitOfMeasure" column="unit_of_measure" type="string"/>
        <many-to-one name="routedPharmacyLocation" class="org.openmrs.module.rwandapharmacymanagement.model.PharmacyLocation" column="routed_pharmacy_location_id"/>
        <property name="lineStatus" column="line_status">
            <type name="org.hibernate.type.EnumType">
                <param name="enumClass">org.openmrs.module.rwandapharmacymanagement.model.enums.RequestStatus</param>
                <param name="useNamed">true</param>
            </type>
        </property>
        <many-to-one name="creator" class="org.openmrs.User" column="creator"/>
        <property name="dateCreated" column="date_created"/>
        <property name="voided" column="voided" type="boolean"/>
        <many-to-one name="voidedBy" class="org.openmrs.User" column="voided_by"/>
        <property name="dateVoided" column="date_voided"/>
        <property name="voidReason" column="void_reason" type="string"/>
        <property name="uuid" column="uuid" type="string"/>
    </class>
</hibernate-mapping>
