<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE hibernate-mapping PUBLIC
 "-//Hibernate/Hibernate Mapping DTD 3.0//EN"
 "http://hibernate.sourceforge.net/hibernate-mapping-3.0.dtd">
<hibernate-mapping package="org.openmrs.module.rwandapharmacymanagement.model">
    <class name="SupplierOrder" table="rpm_supplier_order">
        <id name="supplierOrderId" type="int" column="supplier_order_id" unsaved-value="0">
            <generator class="native"/>
        </id>
        <property name="orderNumber" column="order_number" type="string"/>
        <property name="supplierOrderReference" column="supplier_order_reference" type="string"/>
        <many-to-one name="supplier" class="org.openmrs.module.rwandapharmacymanagement.model.Supplier" column="supplier_id"/>
        <many-to-one name="facilityLocation" class="org.openmrs.Location" column="facility_location_id"/>
        <many-to-one name="requestedBy" class="org.openmrs.User" column="requested_by"/>
        <property name="status" column="status" type="string"/>
        <bag name="lines" cascade="all-delete-orphan" inverse="true" lazy="false">
            <key column="supplier_order_id"/>
            <one-to-many class="org.openmrs.module.rwandapharmacymanagement.model.SupplierOrderLine"/>
        </bag>
        <many-to-one name="creator" class="org.openmrs.User" column="creator"/>
        <property name="dateCreated" column="date_created"/>
        <property name="voided" column="voided" type="boolean"/>
        <many-to-one name="voidedBy" class="org.openmrs.User" column="voided_by"/>
        <property name="dateVoided" column="date_voided"/>
        <property name="voidReason" column="void_reason" type="string"/>
    </class>
</hibernate-mapping>
