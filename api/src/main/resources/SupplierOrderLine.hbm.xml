<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE hibernate-mapping PUBLIC
 "-//Hibernate/Hibernate Mapping DTD 3.0//EN"
 "http://hibernate.sourceforge.net/hibernate-mapping-3.0.dtd">
<hibernate-mapping package="org.openmrs.module.rwandapharmacymanagement.model">
    <class name="SupplierOrderLine" table="rpm_supplier_order_line">
        <id name="supplierOrderLineId" type="int" column="supplier_order_line_id" unsaved-value="0">
            <generator class="native"/>
        </id>
        <many-to-one name="supplierOrder" class="org.openmrs.module.rwandapharmacymanagement.model.SupplierOrder" column="supplier_order_id"/>
        <many-to-one name="item" class="org.openmrs.module.rwandapharmacymanagement.model.Item" column="item_id"/>
        <property name="supplierProductCode" column="supplier_product_code" type="string"/>
        <property name="supplierProductName" column="supplier_product_name" type="string"/>
        <property name="programName" column="program_name" type="string"/>
        <property name="orderedQuantity" column="ordered_quantity" type="big_decimal"/>
        <property name="unitPrice" column="unit_price" type="big_decimal"/>
        <many-to-one name="creator" class="org.openmrs.User" column="creator"/>
        <property name="dateCreated" column="date_created"/>
        <property name="voided" column="voided" type="boolean"/>
        <many-to-one name="voidedBy" class="org.openmrs.User" column="voided_by"/>
        <property name="dateVoided" column="date_voided"/>
        <property name="voidReason" column="void_reason" type="string"/>
    </class>
</hibernate-mapping>
