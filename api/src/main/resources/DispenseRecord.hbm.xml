<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE hibernate-mapping PUBLIC
 "-//Hibernate/Hibernate Mapping DTD 3.0//EN"
 "http://hibernate.sourceforge.net/hibernate-mapping-3.0.dtd">
<hibernate-mapping package="org.openmrs.module.rwandapharmacymanagement.model">
    <class name="DispenseRecord" table="rpm_dispense_record">
        <id name="dispenseRecordId" type="int" column="dispense_record_id" unsaved-value="0">
            <generator class="native"/>
        </id>
        <many-to-one name="patient" class="org.openmrs.Patient" column="patient_id"/>
        <many-to-one name="patientDispensingRequest" class="org.openmrs.module.rwandapharmacymanagement.model.PatientDispensingRequest" column="patient_dispensing_request_id"/>
        <many-to-one name="dispensingPharmacyLocation" class="org.openmrs.module.rwandapharmacymanagement.model.PharmacyLocation" column="dispensing_pharmacy_location_id"/>
        <many-to-one name="dispensedBy" class="org.openmrs.Provider" column="provider_id"/>
        <property name="dispensedWithoutOrder" column="dispensed_without_order" type="boolean"/>
        <bag name="lines" cascade="all-delete-orphan" inverse="true" lazy="false">
            <key column="dispense_record_id"/>
            <one-to-many class="org.openmrs.module.rwandapharmacymanagement.model.DispenseRecordLine"/>
        </bag>
        <many-to-one name="creator" class="org.openmrs.User" column="creator"/>
        <property name="dateCreated" column="date_created"/>
        <property name="voided" column="voided" type="boolean"/>
        <many-to-one name="voidedBy" class="org.openmrs.User" column="voided_by"/>
        <property name="dateVoided" column="date_voided"/>
        <property name="voidReason" column="void_reason" type="string"/>
    </class>
</hibernate-mapping>
